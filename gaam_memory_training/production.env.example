# GAAM production E2E environment template.
#
# Usage:
#   cp production.env.example production.env
#   edit production.env
#   set -a
#   source production.env
#   set +a
#   bash scripts/run_production_e2e_training_and_evaluation.sh
#
# Do not commit production.env or any file containing real API keys.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

PYTHON_BIN=python
INPUT_PATH=data/longmemeval/longmemeval_s_cleaned.json
ORACLE_GRAPH_DIR=outputs/longmemeval_s_graph
CODE_A1_ROOT=/mnt/local2/wxy/GAAM/Code-A1/Code-A1

# Initial trainable model checkpoints.
MEMORY_MODEL_PATH=/mnt/local2/wxy/models/Qwen3-0.6B
QUESTION_MODEL_PATH=/mnt/local2/wxy/models/Qwen3-0.6B

# ---------------------------------------------------------------------------
# Split creation
# ---------------------------------------------------------------------------

# Create SPLIT_MANIFEST from graph-backed cases before training.
AUTO_CREATE_SPLIT=1
SPLIT_SEED=1029
SPLIT_MANIFEST=outputs/splits/longmemeval_s.existing_graphs.seed1029.json
TRAIN_RATIO=0.8
DEV_RATIO=0.1
TEST_RATIO=0.1
ALLOW_EMPTY_SPLIT=0
SPLIT_MAX_CASES=
OVERWRITE_SPLIT=1

# ---------------------------------------------------------------------------
# Native Code-A1/VERL dual-agent GRPO training
# ---------------------------------------------------------------------------

TRAINING_OUTPUT_DIR=outputs/production_native_verl_dual_cotraining
ROUNDS=1
ORDER=question_agent,memory_builder
NUM_GPUS=2
MEMORY_NUM_GPUS=2
QUESTION_NUM_GPUS=2
ROLLOUT_N=4
TRAIN_BATCH_SIZE=8
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
MAX_PROMPT_LENGTH=4096
MAX_RESPONSE_LENGTH=2048
MAX_HISTORY_CHARS=16000
MAX_ORACLE_CHARS=12000
QUESTIONS_PER_CASE=8
MEMORY_INPUT_MODE=full
MAX_RECORDS_PER_SPLIT=
TOTAL_EPOCHS_PER_ACTOR_STEP=1
TOTAL_TRAINING_STEPS_PER_ACTOR_STEP=
SAVE_FREQ=1
TEST_FREQ=1
LR=1e-6
ROLLOUT_TP_SIZE=1
GPU_MEMORY_UTILIZATION=0.6
LOGGER=console
SAVE_HF_MODEL=1
REQUIRE_HF_CHECKPOINT=1
VERIFY_TRAINING_OUTPUT=1

# ---------------------------------------------------------------------------
# Production preflight
# ---------------------------------------------------------------------------

# Run fail-fast checks before expensive native VERL training starts.
RUN_PREFLIGHT=1

# Require torch CUDA availability and enough visible GPUs for the configured
# MEMORY_NUM_GPUS/QUESTION_NUM_GPUS.
REQUIRE_CUDA=1

# Check package imports: torch, transformers, pandas, pyarrow, openai, ray,
# vLLM, and vendored Code-A1/VERL.
CHECK_IMPORTS=1

# Import Code-A1/VERL during preflight. Keep 1 for remote GPU runs.
REQUIRE_VERL_IMPORT=1

# ---------------------------------------------------------------------------
# Reward LLM-as-judge API
# ---------------------------------------------------------------------------

GAAM_REWARD_JUDGE_ENABLED=1
GAAM_REWARD_JUDGE_BASE_URL=https://api.deepseek.com
GAAM_REWARD_JUDGE_API_KEY=
GAAM_REWARD_JUDGE_MODEL=deepseek-v4-flash
GAAM_REWARD_JUDGE_REQUIRED=0
GAAM_REWARD_JUDGE_TIMEOUT=60
GAAM_REWARD_JUDGE_MAX_INPUT_CHARS=20000

# Optional legacy/offline RewardManager judge settings. If unset, these fall
# back to GAAM_REWARD_JUDGE_* above.
GAAM_REWARD_MANAGER_JUDGE_BASE_URL=
GAAM_REWARD_MANAGER_JUDGE_API_KEY=
GAAM_REWARD_MANAGER_JUDGE_MODEL=
GAAM_REWARD_MANAGER_JUDGE_REQUIRED=0
GAAM_REWARD_MANAGER_JUDGE_TIMEOUT=60
GAAM_REWARD_MANAGER_JUDGE_MAX_CHARS=20000

# ---------------------------------------------------------------------------
# Post-training evaluation
# ---------------------------------------------------------------------------

RUN_EVALUATION=1
EVAL_OUTPUT_DIR=outputs/production_post_training_case_evaluation
EVALUATION_SPLIT=test
RECORD_ID=
MAX_RECORDS=
MEMORY_BACKEND=stateful_local_hf
ANSWER_BACKEND=api
JUDGE_BACKEND=api
SESSION_CHUNK_SIZE=4
MAX_CHUNK_CHARS=12000
MAX_PREVIOUS_MEMORY_CHARS=12000
MEMORY_MAX_NEW_TOKENS=2048
MEMORY_DEVICE_MAP=auto
MEMORY_TORCH_DTYPE=auto
ANSWER_MODEL=deepseek-v4-flash
ANSWER_BASE_URL=https://api.deepseek.com
ANSWER_API_KEY=
ANSWER_MAX_NEW_TOKENS=1024
ANSWER_DEVICE_MAP=auto
ANSWER_TORCH_DTYPE=auto
JUDGE_MODEL=deepseek-v4-flash
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
VERIFY_EVALUATION_OUTPUT=1

# ---------------------------------------------------------------------------
# Final audit
# ---------------------------------------------------------------------------

RUN_FINAL_AUDIT=1
EXPORT_ARTIFACT_BUNDLE=1
ARTIFACT_BUNDLE_DIR=outputs/production_artifact_bundle
RUN_ID=
