# GAAM production E2E environment template.
#
# Usage:
#   cp production.env.example production.env
#   edit production.env
#   set -a
#   source production.env
#   set +a
#   bash scripts/run_production_e2e_training_and_evaluation.sh
# Or, preferred on a remote GPU server:
#   bash scripts/run_remote_production_training.sh
#
# Do not commit production.env or any file containing real API keys.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

PYTHON_BIN=python
INPUT_PATH=data/longmemeval/longmemeval_s_cleaned.json
ORACLE_GRAPH_DIR=outputs/longmemeval_s_graph
CODE_A1_ROOT=/mnt/local2/wxy/GAAM/Code-A1/Code-A1

# Initial trainable model checkpoints.
MEMORY_MODEL_PATH=/mnt/local2/wxy/models/Qwen3-0.6B
QUESTION_MODEL_PATH=/mnt/local2/wxy/models/Qwen3-0.6B

# Optional shared API key fallback. Prefer exporting provider keys in the shell
# or filling role-specific keys below in your untracked production.env file.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Split creation
# ---------------------------------------------------------------------------

# Create SPLIT_MANIFEST from graph-backed cases before training.
AUTO_CREATE_SPLIT=1
SPLIT_SEED=1029
SPLIT_MANIFEST=outputs/splits/longmemeval_s.existing_graphs.seed1029.json
TRAIN_RATIO=0.8
DEV_RATIO=0.1
TEST_RATIO=0.1
ALLOW_EMPTY_SPLIT=0
SPLIT_MAX_CASES=
OVERWRITE_SPLIT=1

# ---------------------------------------------------------------------------
# Native Code-A1/VERL dual-agent GRPO training
# ---------------------------------------------------------------------------

TRAINING_OUTPUT_DIR=outputs/production_native_verl_dual_cotraining

# Number of adversarial co-training rounds. Each round updates actors in ORDER.
ROUNDS=1

# Actor update order inside each round.
ORDER=question_agent,memory_builder

# Default GPU count. Actor-specific values below override it.
NUM_GPUS=2
MEMORY_NUM_GPUS=2
QUESTION_NUM_GPUS=2
NNODES=1

# Number of sampled responses per prompt. GRPO needs more than one sample per
# prompt to form a useful group.
ROLLOUT_N=4
MEMORY_ROLLOUT_N=
QUESTION_ROLLOUT_N=

# Native VERL batch sizes. Actor-specific values override TRAIN_BATCH_SIZE.
TRAIN_BATCH_SIZE=8
MEMORY_TRAIN_BATCH_SIZE=
QUESTION_TRAIN_BATCH_SIZE=
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1

# Prompt/response token budgets. Actor-specific values override shared values.
MAX_PROMPT_LENGTH=4096
MEMORY_MAX_PROMPT_LENGTH=
QUESTION_MAX_PROMPT_LENGTH=
MAX_RESPONSE_LENGTH=2048
MEMORY_MAX_RESPONSE_LENGTH=
QUESTION_MAX_RESPONSE_LENGTH=

# Character budgets used before tokenization when creating native VERL parquet.
MAX_HISTORY_CHARS=16000
MAX_ORACLE_CHARS=12000

# Exact target number of training questions generated per case.
QUESTIONS_PER_CASE=8

# Native parquet Memory Builder mode. Keep "full" for production native VERL.
# Static "incremental" parquet export is disabled by default because true
# incremental memory requires stateful rollout.
MEMORY_INPUT_MODE=full
MEMORY_SESSION_CHUNK_SIZE=4
MAX_MEMORY_CHUNK_CHARS=
MAX_PREVIOUS_MEMORY_CHARS=6000
ALLOW_STATIC_INCREMENTAL_SCAFFOLD=0

# Optional cap per split for debugging. Leave empty for full training splits.
MAX_RECORDS_PER_SPLIT=

# Training duration. Leave TOTAL_TRAINING_STEPS_PER_ACTOR_STEP empty for
# epoch-driven training; set it only for short smoke runs.
TOTAL_EPOCHS_PER_ACTOR_STEP=1
TOTAL_TRAINING_STEPS_PER_ACTOR_STEP=

# Native VERL checkpoint/test cadence.
SAVE_FREQ=1
TEST_FREQ=1

# Optimizer and vLLM rollout settings.
LR=1e-6
ROLLOUT_TP_SIZE=1
GPU_MEMORY_UTILIZATION=0.6
LOGGER=console

# Full-model checkpoint controls. Keep enabled for real training.
SAVE_HF_MODEL=1
REQUIRE_HF_CHECKPOINT=1
VERIFY_TRAINING_OUTPUT=1

# Dry run only validates orchestration and does not train. Keep 0 for real runs.
DUAL_DRY_RUN=0

# ---------------------------------------------------------------------------
# Production preflight
# ---------------------------------------------------------------------------

# Run fail-fast checks before expensive native VERL training starts.
RUN_PREFLIGHT=1

# Require torch CUDA availability and enough visible GPUs for the configured
# MEMORY_NUM_GPUS/QUESTION_NUM_GPUS.
REQUIRE_CUDA=1

# Check package imports: torch, transformers, pandas, pyarrow, openai, ray,
# vLLM, and vendored Code-A1/VERL.
CHECK_IMPORTS=1

# Import Code-A1/VERL during preflight. Keep 1 for remote GPU runs.
REQUIRE_VERL_IMPORT=1

# Optional diagnostics report. This does not start training; it records package
# versions, CUDA status, nvidia-smi output, redacted env, and preflight results.
DIAGNOSTICS_OUTPUT=outputs/remote_training_diagnostics.json

# ---------------------------------------------------------------------------
# Remote launcher controls
# ---------------------------------------------------------------------------

# scripts/run_remote_production_training.sh loads this env file by default.
ENV_FILE=production.env
LOAD_ENV_FILE=1

# Install dependencies before diagnostics/training. Keep 0 after the
# environment is already prepared.
INSTALL_DEPS_BEFORE_TRAINING=0
INSTALL_GAAM_DEPS=1
INSTALL_LOCAL_TRAINING_DEPS=1
INSTALL_VERL_DEPS=1
INSTALL_VLLM=1
VLLM_VERSION=0.8.4
INSTALL_FLASH_ATTN=0
FLASH_ATTN_SPEC=flash-attn
FLASH_ATTN_NO_BUILD_ISOLATION=1
RUN_PIP_CHECK=1

# Run diagnostics before launching expensive training.
RUN_DIAGNOSTICS_BEFORE_TRAINING=1

# If 0, failed diagnostics stop the launcher before training starts.
ALLOW_FAILED_DIAGNOSTICS=0

# If 1, launch scripts/run_production_e2e_training_and_evaluation.sh after
# diagnostics.
RUN_TRAINING=1

# ---------------------------------------------------------------------------
# Reward LLM-as-judge API
# ---------------------------------------------------------------------------

GAAM_REWARD_JUDGE_ENABLED=1
GAAM_REWARD_JUDGE_BASE_URL=https://api.deepseek.com
GAAM_REWARD_JUDGE_API_KEY=
GAAM_REWARD_JUDGE_MODEL=deepseek-v4-flash
GAAM_REWARD_JUDGE_REQUIRED=0
GAAM_REWARD_JUDGE_TIMEOUT=60
GAAM_REWARD_JUDGE_MAX_INPUT_CHARS=20000

# Optional legacy/offline RewardManager judge settings. If unset, these fall
# back to GAAM_REWARD_JUDGE_* above.
GAAM_REWARD_MANAGER_JUDGE_BASE_URL=
GAAM_REWARD_MANAGER_JUDGE_API_KEY=
GAAM_REWARD_MANAGER_JUDGE_MODEL=
GAAM_REWARD_MANAGER_JUDGE_REQUIRED=0
GAAM_REWARD_MANAGER_JUDGE_TIMEOUT=60
GAAM_REWARD_MANAGER_JUDGE_MAX_CHARS=20000

# ---------------------------------------------------------------------------
# Post-training evaluation
# ---------------------------------------------------------------------------

RUN_EVALUATION=1
EVAL_OUTPUT_DIR=outputs/production_post_training_case_evaluation
EVALUATION_SPLIT=test
RECORD_ID=
MAX_RECORDS=
MEMORY_BACKEND=stateful_local_hf
ANSWER_BACKEND=api
JUDGE_BACKEND=api
SESSION_CHUNK_SIZE=4
MAX_CHUNK_CHARS=12000
MAX_PREVIOUS_MEMORY_CHARS=12000

# Memory Builder evaluation model settings. When MEMORY_BACKEND=stateful_local_hf,
# MEMORY_MODEL is resolved from the trained checkpoint unless explicitly set.
MEMORY_MODEL=
MEMORY_BASE_URL=https://api.deepseek.com
MEMORY_API_KEY=
MEMORY_MAX_NEW_TOKENS=2048
MEMORY_DEVICE_MAP=auto
MEMORY_TORCH_DTYPE=auto

# Optional aliases consumed by Python defaults and wrappers.
GAAM_MEMORY_BUILDER_MODEL=
GAAM_MEMORY_BUILDER_BASE_URL=
GAAM_MEMORY_BUILDER_API_KEY=
GAAM_MEMORY_BUILDER_MAX_NEW_TOKENS=2048
GAAM_MEMORY_BUILDER_DEVICE_MAP=auto
GAAM_MEMORY_BUILDER_TORCH_DTYPE=auto

# Frozen Answerer settings.
ANSWER_MODEL=deepseek-v4-flash
ANSWER_BASE_URL=https://api.deepseek.com
ANSWER_API_KEY=
ANSWER_MAX_NEW_TOKENS=1024
ANSWER_DEVICE_MAP=auto
ANSWER_TORCH_DTYPE=auto
GAAM_ANSWERER_MODEL=
GAAM_ANSWERER_BASE_URL=
GAAM_ANSWERER_API_KEY=
GAAM_ANSWERER_MAX_NEW_TOKENS=1024
GAAM_ANSWERER_DEVICE_MAP=auto
GAAM_ANSWERER_TORCH_DTYPE=auto

# Evaluation judge settings.
JUDGE_MODEL=deepseek-v4-flash
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
GAAM_EVAL_JUDGE_MODEL=
GAAM_EVAL_JUDGE_BASE_URL=
GAAM_EVAL_JUDGE_API_KEY=
VERIFY_EVALUATION_OUTPUT=1
REQUIRE_RESOLVED_CHECKPOINTS=1

# ---------------------------------------------------------------------------
# Final audit
# ---------------------------------------------------------------------------

RUN_FINAL_AUDIT=1
EXPORT_ARTIFACT_BUNDLE=1
ARTIFACT_BUNDLE_DIR=outputs/production_artifact_bundle

# Verify bundle manifest, copied files, checksums, and tarball after export.
VERIFY_ARTIFACT_BUNDLE=1

# Verify final production evidence after training, evaluation, audit, and bundle
# checks. Keep enabled for real E2E runs.
VERIFY_PRODUCTION_COMPLETION=1
RUN_ID=
